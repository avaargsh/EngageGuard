{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avaargsh.github.io/EngageGuard/contracts/action-request.v1.schema.json",
  "title": "EngageGuard ActionRequest v1",
  "description": "Untrusted caller intent only. Authentication, operation identity, trusted bindings, policy and executor audience are derived by EngageGuard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "run_id",
    "decision_id",
    "plan_id",
    "plan_hash",
    "step_id",
    "capability",
    "resource_ref",
    "arguments"
  ],
  "properties": {
    "schema_version": { "const": "action-request.v1" },
    "agent_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "decision_id": { "$ref": "#/$defs/identifier" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "plan_hash": { "$ref": "#/$defs/sha256" },
    "step_id": { "$ref": "#/$defs/identifier" },
    "capability": { "$ref": "#/$defs/capabilityRequest" },
    "resource_ref": { "$ref": "#/$defs/identifier" },
    "arguments": {
      "type": "object",
      "description": "Capability-specific input. Maximum encoded size is 65536 bytes; duplicate keys are rejected."
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n\\t ]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
