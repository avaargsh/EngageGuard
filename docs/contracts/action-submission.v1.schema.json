{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avaargsh.github.io/EngageGuard/contracts/action-submission.v1.schema.json",
  "title": "ActionSubmission v1 - untrusted intent only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "decision_id",
    "plan_id",
    "plan_hash",
    "step_id",
    "capability",
    "resource_ref",
    "arguments"
  ],
  "properties": {
    "schema_version": {
      "const": "action-submission.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "capability": {
      "$ref": "#/$defs/capability"
    },
    "resource_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "arguments": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "contract_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
